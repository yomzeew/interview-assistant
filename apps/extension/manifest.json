{
  "manifest_version": 3,
  "name": "Interview Caption Assistant",
  "version": "1.1.0",
  "description": "Live AI interview coach for Google Meet, Teams & Zoom. Real-time captions, STAR-method answers from your CV, speaker detection, and post-session summaries.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.onrender.com/*",
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Interview Caption Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html", "audio-processor.js", "chunks/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
